# Supabase — the project's public endpoint and its browser-safe key.
# Both are compiled into the client bundle by design; they are protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase — the service role key. BYPASSES RLS ENTIRELY.
# Server only, and read by exactly one caller: the Stripe webhook, which has no
# session behind it and must call redeem_hold. Never prefix this NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe — the secret key for the institute's account.
# Use the TEST key (sk_test_...) everywhere until the board has signed off on
# going live. A live key here takes real money from real people.
STRIPE_SECRET_KEY=sk_test_...

# Stripe — the webhook signing secret.
# `stripe listen` prints its own (whsec_...) for local development; the
# dashboard issues a different one per deployed endpoint. They are not
# interchangeable, and a mismatch rejects every delivery with a 400.
STRIPE_WEBHOOK_SECRET=whsec_...

# The site's own origin, used to build Stripe's success and cancel URLs.
# Optional locally — it falls back to the request's Host header. Set it in any
# deployed environment so a forged Host cannot end up in a payment URL.
# NEXT_PUBLIC_SITE_URL=https://tarbiya.masnewyork.org

# Resend — the API key the app sends email through.
# Resend dashboard -> API keys. Sending permission is enough; it does not need
# full access. The domain send.masnewyork.org must be verified first.
RESEND_API_KEY=re_...

# Who the institute's mail comes from, and where replies land.
# Both have working defaults in lib/email.ts; set them only to override, e.g.
# to point a preview deployment somewhere harmless.
# EMAIL_FROM="MAS Tarbiya Institute <institute@send.masnewyork.org>"
# EMAIL_REPLY_TO=bk.institute@masnewyork.org
